# Supabase (Project Settings → API keys). Use the publishable/anon key, never the service_role/secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Your IANA timezone for "today" / month boundaries on the server (defaults to UTC)
NEXT_PUBLIC_APP_TZ=UTC

# Push notifications (optional). Generate keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A URL or mailto: the push services can contact about this deployment
VAPID_SUBJECT=
# Random 32+ char secret shared with Supabase (see README → Notifications)
PUSH_CRON_SECRET=
